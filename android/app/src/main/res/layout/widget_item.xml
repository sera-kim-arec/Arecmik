<LinearLayout android:id="@+id/widget_item_root" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingRight="8dp" android:background="@drawable/widget_item_bg">
    <ImageView android:id="@+id/item_check" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_task_open" android:contentDescription="완료로 표시"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/item_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#424D39" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/item_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="#9AA28F"/>
    </LinearLayout>
</LinearLayout>
